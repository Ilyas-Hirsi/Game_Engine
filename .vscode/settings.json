{
  "cmake.configureOnOpen": false,
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.configureSettings": {
    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
  },
  "cmake.useCMakePresets": "always",
  "cmake.configurePreset": "debug",
  "cmake.buildPreset": "debug",
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/engine",
    "${workspaceFolder}/third_party/sdl2/SDL2-2.30.10/include",
    "${workspaceFolder}/build/_deps/sdl2-src/include",
    "${workspaceFolder}/build/_deps/sdl2_image-src/include",
    "${workspaceFolder}/build/_deps/glad-build/include",
    "${workspaceFolder}/build/_deps/glm-src"
  ],
  "files.associations": {
    "*.h": "cpp",
    "system_error": "cpp",
    "chrono": "cpp",
    "xlocale": "cpp",
    "xstring": "cpp",
